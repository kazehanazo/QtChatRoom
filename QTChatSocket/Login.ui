}
QLabel#profileLabel
{	
	background-color: rgb(255, 255, 255);
	border-radius: 35px;
	border:1px solid black;
}
QLineEdit
{
	background-color: qradialgradient(spread:pad, cx:0.415, cy:0.545455, radius:0.846, fx:0.0688832, fy:0.523, stop:0.138593 rgba(0, 237, 239, 255), stop:0.948827 rgba(255, 255, 255, 255));
	border-radius: 15px; 
	border: none;
}
QComboBox
{
	background-color: qradialgradient(spread:pad, cx:0.415, cy:0.545455, radius:0.846, fx:0.0688832, fy:0.523, stop:0.138593 rgba(0, 237, 239, 255), stop:0.948827 rgba(255, 255, 255, 255));
	border-radius: 15px; 
	border: none;
}
QComboBox::drop-down 
{
	background: transparent;
    subcontrol-origin: padding; 
    subcontrol-position: right center; 
    width: 20px; 
    height: 20px; 
    border-radius: 10px;  
}
QComboBox::down-arrow
{
	border-image: url(:/imgs/arrow-down.svg);
    width: 15px; 
    height: 15px; 
}
QComboBox::down-arrow:pressed
{
	border-image: url(:/imgs/arrow-up-bold.svg);
    width: 15px; 
    height: 15px; 
}
QPushButton#loginButton
{
	color: rgb(255, 255, 255);
	border-radius: 15px; 
	border: none;
	background-color: qlineargradient(spread:pad, x1:0.338, y1:0.522182, x2:0.936, y2:0.87, stop:0.0500894 rgba(0, 194, 244, 255), stop:0.951699 rgba(255, 255, 255, 255));
}
QPushButton#registerButton
{
	color: rgb(255, 255, 255);
	border-radius: 15px; 
	border: none;
	background-color: qlineargradient(spread:pad, x1:0.338, y1:0.522182, x2:0.936, y2:0.87, stop:0.0500894 rgba(0, 194, 244, 255), stop:0.951699 rgba(255, 255, 255, 255));
}
QPushButton:hover
{
	color: rgb(0, 0, 0);
}</string>
